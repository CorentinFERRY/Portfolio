# Environment variables read by the backend. Copy this file to .env, fill in
# the real values locally, and never commit .env (see AGENTS.md section 9).
# These are plain environment variables: export them in your shell or set them
# in your IDE run configuration. No loader is implied by this file.
GITHUB_TOKEN=replace-me
GITHUB_OWNER=replace-me
# Optional. Blank or unset falls back to https://api.github.com.
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_CONNECT_TIMEOUT_MS=3000
# GITHUB_READ_TIMEOUT_MS=10000
# GITHUB_CACHE_TTL_MS=300000
# GITHUB_CACHE_MAXIMUM_SIZE=100
# Optional. Comma-separated browser origins allowed to call the API (CORS):
# https only, except http://localhost:<port> and http://127.0.0.1:<port>.
# Unset or blank rejects every cross-origin request with 403.
# PORTFOLIO_CORS_ALLOWED_ORIGINS=https://portfolio.example,http://localhost:5173

# Optional frontend dev proxy target for /api, exported in the shell: Vite does
# not load this file. Unset falls back to http://127.0.0.1:8080.
# PORTFOLIO_BACKEND_URL=http://127.0.0.1:8080
