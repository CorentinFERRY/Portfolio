# Environment variables read by the backend. Copy this file to .env, fill in
# the real values locally, and never commit .env (see AGENTS.md section 9).
# These are plain environment variables: export them in your shell or set them
# in your IDE run configuration. No loader is implied by this file.
GITHUB_TOKEN=replace-me
GITHUB_OWNER=replace-me
# Overridden in tests so the GitHub API is always simulated.
GITHUB_API_BASE_URL=https://api.github.com
